# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.
# Docker Compose reads this file automatically (docker compose up).

# --- Database (shared by db + cms services) ---
DATABASE_NAME=panah_cms
DATABASE_USERNAME=panah
DATABASE_PASSWORD=change_me

# --- Strapi secrets ---
# Generate fresh values for each environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
# APP_KEYS needs 4 comma-separated values.
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=change_me
ADMIN_JWT_SECRET=change_me
JWT_SECRET=change_me
TRANSFER_TOKEN_SALT=change_me
ENCRYPTION_KEY=change_me

# --- Next.js frontend ---
# Base URL the frontend uses to reach Strapi's API.
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
